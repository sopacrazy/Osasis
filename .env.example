# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mestre de IA local e offline (Ollama). Padrão: gemini
# LLM_PROVIDER="ollama"
# OLLAMA_MODEL="qwen3:4b-instruct"
# OLLAMA_URL="http://127.0.0.1:11434"

# ---- Narrador por voz (Chatterbox local) ----------------------------------
# Serviço Python em tts-service/ (veja NARRADOR.md). Sem ele o jogo usa a voz do navegador.
# TTS_URL="http://127.0.0.1:8808"
# TTS_TOKEN=""                      # opcional: o mesmo valor no serviço (TTS_TOKEN)
# TTS_MAX_CHARS=600                 # máximo de caracteres por trecho
# TTS_RATE_LIMIT_PER_MINUTE=90      # pedidos de narração por minuto, por IP

# ---- Contas e login ------------------------------------------------------
# Código(s) de convite para criar conta (vários separados por vírgula). Sem isso o cadastro fica desativado.
# INVITE_CODE="troque-por-um-codigo-seu"
# Caminho-base do site quando hospedado em um subcaminho (cookie de sessão). Ex.: /rpg
# PUBLIC_BASE_PATH="/rpg"
# Força cookie "Secure" (use true quando o site estiver em HTTPS). Padrão: automático.
# COOKIE_SECURE=false

# ---- Banco de dados (MariaDB/MySQL) --------------------------------------
# Com DB_HOST definido, contas e campanhas ficam no MariaDB (as tabelas são criadas sozinhas).
# Sem DB_HOST, o app usa arquivos locais em ./data (apenas para desenvolvimento).
# DB_HOST="127.0.0.1"
# DB_PORT=3306
# DB_USER="rpg_app"
# DB_PASSWORD="..."
# DB_NAME="rpg_cronica"
