# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mestre de IA local e offline (Ollama). Padrão: gemini
# LLM_PROVIDER="ollama"
# OLLAMA_MODEL="qwen3:4b-instruct"
# OLLAMA_URL="http://127.0.0.1:11434"

# ---- Narrador por voz (ElevenLabs) --------------------------------------
# A chave fica SOMENTE no servidor; nunca é enviada ao navegador.
# ELEVENLABS_API_KEY="..."
# voice_id da voz do narrador (veja NARRADOR.md para escolher uma voz grave/madura em pt-BR)
# ELEVENLABS_VOICE_ID="..."
# ELEVENLABS_MODEL="eleven_flash_v2_5"
# Limite de caracteres aceitos por requisição de narração (padrão 600)
# NARRATOR_MAX_CHARS_PER_REQUEST=600
# Orçamento mensal ESTIMADO em créditos (padrão 5000). O servidor recusa (402) ao atingi-lo.
# NARRATOR_MONTHLY_CREDIT_BUDGET=5000
# Créditos estimados por caractere (Flash/Turbo ~0.5). Ajuste conforme o seu plano.
# NARRATOR_CREDITS_PER_CHAR=0.5
# Requisições de narração por minuto, por IP (padrão 40)
# NARRATOR_RATE_LIMIT_PER_MINUTE=40
# Acesso de fora da máquina (fora do localhost) exige este token no header Authorization: Bearer <token>
# NARRATOR_AUTH_TOKEN=""
# Pasta do cache de áudio e do contador de consumo (padrão .cache/narracao)
# NARRATOR_CACHE_DIR=".cache/narracao"

# ---- Gemini (alternativa gratuita ao Ollama, para rodar sem o seu PC) ----
# Chave grátis em https://aistudio.google.com/apikey  ->  LLM_PROVIDER="gemini"
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-4-hydrogen"
# GEMINI_THINKING="LOW"   # MINIMAL | LOW | MEDIUM | HIGH (baixo = resposta mais rápida)

# ---- Contas e login ------------------------------------------------------
# Código(s) de convite para criar conta (vários separados por vírgula). Sem isso o cadastro fica desativado.
# INVITE_CODE="troque-por-um-codigo-seu"
# Caminho-base do site quando hospedado em um subcaminho (cookie de sessão). Ex.: /rpg
# PUBLIC_BASE_PATH="/rpg"
# Força cookie "Secure" (use true quando o site estiver em HTTPS). Padrão: automático.
# COOKIE_SECURE=false

# ---- Banco de dados (MariaDB/MySQL) --------------------------------------
# Com DB_HOST definido, contas e campanhas ficam no MariaDB (as tabelas são criadas sozinhas).
# Sem DB_HOST, o app usa arquivos locais em ./data (apenas para desenvolvimento).
# DB_HOST="127.0.0.1"
# DB_PORT=3306
# DB_USER="rpg_app"
# DB_PASSWORD="..."
# DB_NAME="rpg_cronica"
